# .env로 복사해 값을 채운다. .env는 Git에 올리지 않는다 (NF2003).

# OpenAI 키 (SSAFY GMS 키를 쓰면 아래 OPENAI_BASE_URL도 함께 설정)
OPENAI_API_KEY=
# OpenAI 호환 프록시 주소. 직접 OpenAI를 쓰면 비워 둔다. GMS는 GMS 안내 페이지의 base URL을 넣는다.
OPENAI_BASE_URL=

# 위키백과 User-Agent: 앱 이름과 연락처(이메일)를 반드시 포함 (NF2006)
WIKI_USER_AGENT=kdca-rag/0.1 (contact: your-email@example.com)

# (선택) LangSmith 추적: 프롬프트별 입출력 확인에 유용
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kdca-rag

# (1일차 EDA용) 공공데이터포털 Decoding 키
DATA_GO_KR_SERVICE_KEY=
